<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- TOPO DO TINDER -->
    <ImageView
        android:id="@+id/imgTopo"
        android:layout_width="0dp"
        android:layout_height="75dp"
        android:src="@drawable/Topo"
        android:scaleType="centerInside"
        android:contentDescription="Topo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- CARD PRINCIPAL -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardPerfil"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="3dp"
        app:layout_constraintTop_toBottomOf="@id/imgTopo"
        app:layout_constraintBottom_toTopOf="@id/imgBotoes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- FOTO -->
            <ImageView
                android:id="@+id/imgPerfil"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/loira"
                android:scaleType="centerCrop"
                android:contentDescription="Foto do perfil"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- ÁREA INVISÍVEL PARA VOLTAR -->
            <View
                android:id="@+id/areaEsquerda"
                android:layout_width="80dp"
                android:layout_height="0dp"
                android:background="@android:color/transparent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- ÁREA INVISÍVEL PARA AVANÇAR -->
            <View
                android:id="@+id/areaDireita"
                android:layout_width="80dp"
                android:layout_height="0dp"
                android:background="@android:color/transparent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- FAIXA BRANCA INFERIOR -->
            <View
                android:id="@+id/fundoInformacoes"
                android:layout_width="0dp"
                android:layout_height="85dp"
                android:background="#FFFFFF"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- NOME -->
            <TextView
                android:id="@+id/txtNome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="25dp"
                android:text="Lindsey, 25"
                android:textColor="#333333"
                android:textSize="25sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="@id/fundoInformacoes" />

            <!-- ÍCONE / NÚMERO -->
            <TextView
                android:id="@+id/txtCurtidas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="22dp"
                android:text="👥 18"
                android:textColor="#F06262"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/fundoInformacoes"
                app:layout_constraintBottom_toBottomOf="@id/fundoInformacoes" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <!-- BOTÕES INFERIORES -->
    <ImageView
        android:id="@+id/imgBotoes"
        android:layout_width="0dp"
        android:layout_height="125dp"
        android:src="@drawable/botoes"
        android:scaleType="centerInside"
        android:contentDescription="Botões"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>